# 업비트 Open API 키 (실거래에만 필요)
# 발급: https://upbit.com/mypage/open_api_management
#
# 중요:
#   - '출금' 권한은 절대 켜지 마세요. 자산조회 + 주문 권한이면 충분합니다.
#   - 허용 IP를 등록하세요. 키가 유출돼도 다른 곳에서는 쓸 수 없습니다.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 체결 알림 웹훅 (선택) — 슬랙/디스코드 등
# BTCBOT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Claude API 키 (선택) — "말로 설명하기" 기능에만 씁니다.
# 발급: https://console.anthropic.com
# 이 키는 전략 문장을 조건으로 옮길 때만 쓰이고, 주문에는 관여하지 않습니다.
# ANTHROPIC_API_KEY=sk-ant-...
